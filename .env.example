# ──────────────────────────────────────────────────────────────
# DropQR — variables d’environnement (aucun secret à versionner)
# Renseigne ton hébergeur, ou copie ce fichier en .env et lance :
# node --env-file=.env server.js  (Node.js 20.6+)
# Sous Node.js 18, exporte les variables avant npm start.
# ──────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Adresse publique HTTPS utilisée dans les liens, QR et redirections OAuth.
# Ne pas utiliser localhost pour un partage entre appareils.
PUBLIC_URL=

# Taille maximale : 10 Go par défaut, sous réserve des limites de l’hébergeur.
# MAX_FILE_SIZE=2gb
# MAX_FILE_SIZE_MB=2048
# MAX_FILE_SIZE=unlimited
# DEFAULT_TTL_MINUTES=15
# MAX_TTL_MINUTES=1440
# CHUNK_SIZE_MB=16
# UPLOAD_CONCURRENCY=5
# Dossier local de stockage (par défaut : storage/ à la racine du projet).
# STORAGE_DIR=storage

# Keep-alive interne : ne peut pas réveiller un serveur déjà endormi.
# KEEP_ALIVE=true
# KEEP_ALIVE_URL=              # par défaut : PUBLIC_URL

# ── Discord 1/3 — notifications du staff ──
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=DropQR
# DISCORD_MENTION=<@123456789>
# DISCORD_MENTION=<@&123456789>
# DISCORD_NOTIFY=false

# ── Discord 2/3 — rotation du lien de contact ──
DISCORD_BOT_TOKEN=
DISCORD_INVITE_CHANNEL_ID=
DISCORD_INVITE_REFRESH_HOURS=24
DISCORD_CONTACT_URL=

# ── Discord 3/3 — connexion facultative des visiteurs ──
# Ces deux variables OAuth2 (différentes du token du bot) activent le bouton.
# Application : https://discord.com/developers/applications
# Redirect URI : https://ton-domaine/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# DISCORD_SESSION_DAYS=30
# DISCORD_HEARTBEAT=true
# DISCORD_HEARTBEAT_HOURS=24
